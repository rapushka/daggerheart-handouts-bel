    - target: {fileID: 623750329352844552, guid: 938971bbe6071e6dd8a5138f53d4fbba, type: 3}
      propertyPath: m_text
      value: "<b>\u0406\u043D\u0456\u0446\u044B\u044F\u0432\u0430\u0446\u044C \u041A\u0430\u043C\u0430\u043D\u0434\u043D\u044B
        \u041A\u0456\u0434\u043E\u043A</b> \u2013  <style=\"highlight\">3 \u043D\u0430\u0434\u0437\u0435\u0456</style>\n\u25AA
        \u0430\u043F\u0456\u0448\u044B\u0446\u0435, \u044F\u043A \u0432\u044B \u0441\u0456\u043D\u044D\u0440\u0433\u0443\u0435\u0446\u0435
        \u0434\u0437\u0435\u0456 \u0437 \u0456\u043D\u0448\u044B\u043C PC\n\u25AA
        \u0432\u044B \u0430\u0431\u043E\u0435 \u0440\u043E\u0431\u0456\u0446\u0435
        \u0430\u0441\u043E\u0431\u043D\u044B\u044F \u041A\u0456\u0434\u043A\u0456-\u0414\u0437\u0435\u0456\n\u25AA
        \u0434\u043B\u044F \u0440\u044D\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430
        \u0430\u0431\u044F\u0440\u044B\u0446\u0435 \u0442\u043E\u043B\u044C\u043A\u0456
        \u0430\u0434\u0437\u0456\u043D \u043A\u0456\u0434\u043E\u043A\n\u25AA <u>\u0420\u044D\u0441\u0443\u0440\u0441
        \u0433\u0435\u043D\u0435\u0440\u0443\u0435\u0446\u0446\u0430 \u0437\u0430
        \u043A\u043E\u0436\u043D\u0430\u0433\u0430 \u0433\u0443\u043B\u044C\u0446\u0430
        \u0430\u0441\u043E\u0431\u043D\u0430</u>"
