    - target: {fileID: 3320165820468015327, guid: 20f2092b2c77cbfac88b3e931daf05bf, type: 3}
      propertyPath: m_text
      value: "\u041F\u0430\u0434\u0447\u0430\u0441 \u0430\u0434\u043F\u0430\u0447\u044B\u043D\u043A\u0443
        \u0432\u044B \u043C\u043E\u0436\u0430\u0446\u0435 \u045E\u043B\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044C
        \u041F\u0456\u0440\n\u0413\u0430\u0442\u0443\u0439\u0446\u0435, \u0432\u044B\u043A\u0430\u0440\u044B\u0441\u0442\u043E\u045E\u0432\u0430\u044E\u0447\u044B
        \u0441\u0432\u0430\u0435 \u0456\u043D\u0433\u0440\u044B\u0434\u044B\u0435\u043D\u0442\u044B\n\u043F\u043E\u0442\u044B\u043C
        \u0430\u0434\u043D\u0430\u045E\u043B\u044F\u0439\u0446\u0435 HP, \u0421\u0442\u0440\u044D\u0441,
        \u041D\u0430\u0434\u0437\u0435\u044E \u0437\u0430 \"\u0440\u044D\u0439\u0442\u044B\u043D\u0433
        \u0441\u0442\u0440\u0430\u0432\u044B\""
