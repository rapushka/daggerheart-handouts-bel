      propertyPath: m_text
      value: "<b>\u0421\u0445\u0430\u0432\u0430\u043D\u044B (Hidden)</b> \u2014 \u0432\u044B
        \u043D\u0435 \u045E \u043F\u043E\u043B\u0456 \u0437\u0440\u043E\u043A\u0443
        \u0432\u043E\u0440\u0430\u0433\u0430\u045E \u0456 \u044F\u043D\u044B \u043D\u044F
        \u0432\u0435\u0434\u0430\u044E\u0446\u044C \u0432\u0430\u0448\u0443\u044E
        \u043B\u0430\u043A\u0430\u0446\u044B\u044E\n\u25AA \u041A\u0456\u0434\u043A\u0456
        \u0441\u0443\u043F\u0440\u0430\u0446\u044C  <i>\u0421\u0445\u0430\u0432\u0430\u043D\u044B\u0445</i> 
        \u0456\u0441\u0442\u043E\u0442 \u043C\u0430\u044E\u0446\u044C  <i>\u041F\u0430\u043C\u0435\u0445\u0443</i>\n\u25AA
        \u041A\u0430\u043B\u0456 \u0432\u044B \u0430\u043F\u044B\u043D\u0456\u0446\u0435\u0441\u044F
        \u045E \u043F\u043E\u043B\u0456 \u0437\u0440\u043E\u043A\u0443 \u0432\u043E\u0440\u0430\u0433\u0430\u045E,
        \u0446\u0456 \u0437\u0440\u043E\u0431\u0456\u0446\u0435 \u0430\u0442\u0430\u043A\u0443
        \u2014 \u0441\u0442\u0430\u043D \u0441\u043A\u043E\u043D\u0447\u044B\u0446\u0446\u0430"
