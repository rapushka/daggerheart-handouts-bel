--- !u!1001 &157183977
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 727832745}
    m_Modifications:
    - target: {fileID: 623750329352844552, guid: 938971bbe6071e6dd8a5138f53d4fbba, type: 3}
      propertyPath: m_text
      value: "<b>\u0420\u044B\u0437\u044B\u043A\u043D\u0443\u0446\u044C \u0423\u0441\u0456\u043C</b>
        \u2014 PC \u043C\u043E\u0436\u0430 \u044F\u043A \u0456 \u045E\u0441\u0442\u0430\u0446\u044C
        \u0456\u0437\u043D\u043E\u045E \u043D\u0430 \u043D\u043E\u0433\u0456, \u0442\u0430\u043A
        \u0439 \u043A\u0430\u043D\u0447\u0430\u0442\u043A\u043E\u0432\u0430 \u043F\u0430\u043C\u0451\u0440\u0446\u0456\n\u25AA 
        \u043A\u0456\u043D\u044C\u0446\u0435 \u0414\u0430\u0439\u0441\u044B \u0414\u0443\u0430\u043B\u044C\u043D\u0430\u0441\u0446\u0456\n\u25AA 
        \u0414\u0430\u0439\u0441 \u041D\u0430\u0434\u0437\u0435\u0456 \u0432\u044B\u0448\u044D\u0439\u0448\u044B
        \u2014 PC \u0441\u0442\u0430\u0435 \u043D\u0430 \u043D\u043E\u0433\u0456,
        \u0439 \u0430\u0447\u044B\u0448\u0447\u0430\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u0456
        HP/\u0421\u0442\u0440\u044D\u0441\u0443, \u043A\u043E\u043B\u044C\u043A\u0456
        \u0432\u044B\u043F\u0430\u043B\u0430 \u043D\u0430 \u0414\u0430\u0439\u0441\u0443
        \u041D\u0430\u0434\u0437\u0435\u0456\n\u25AA  \u0414\u0430\u0439\u0441 \u0421\u0442\u0440\u0430\u0445\u0443
        \u0432\u044B\u0448\u044D\u0439\u0448\u044B \u2014 PC \u043A\u0430\u043D\u0447\u0430\u0442\u043A\u043E\u0432\u0430
        \u043F\u0430\u043C\u0456\u0440\u0430\u0435\n\u25AA  \u041A\u0440\u044B\u0442.\u041F\u043E\u0441\u043F\u0435\u0445
        \u2014 PC \u0430\u0447\u044B\u0448\u0447\u0430\u0435 \u045E\u0441\u0435 HP
        \u0456 \u0421\u0442\u0440\u044D\u0441"
      objectReference: {fileID: 0}
