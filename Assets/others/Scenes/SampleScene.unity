      propertyPath: m_text
      value: "<b>\u041F\u043E\u043B\u044B\u043C\u044F \u0421\u043B\u0430\u0432\u044B</b>
        \u2014 PC \u043F\u0440\u044B\u0439\u043C\u0430\u0435 \u0441\u043C\u0435\u0440\u0446\u044C
        \u0456 \u0440\u043E\u0431\u0456\u0446\u044C \u0430\u043F\u043E\u0448\u043D\u0456
        \u043F\u043E\u0434\u0437\u0432\u0456\u0433\n\u25AA \u0437\u0440\u0430\u0431\u0456\u0446\u0435
        \u0430\u0434\u0437\u0456\u043D \u0445\u043E\u0434 (\u0443\u0441\u043F\u0430\u0433\u0430\u0434\u043D\u0456\u045E\u0448\u044B
