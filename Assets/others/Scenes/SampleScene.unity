  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 2051698435}
    m_Modifications:
    - target: {fileID: 623750329352844552, guid: 938971bbe6071e6dd8a5138f53d4fbba, type: 3}
      propertyPath: m_text
      value: "<b>\u0414\u0430\u043F\u0430\u043C\u0430\u0433\u0447\u044B \u0421\u0430\u044E\u0437\u043D\u0456\u043A\u0443</b>
        \u2013  <style=\"highlight\">1 \u043D\u0430\u0434\u0437\u0435\u044F</style>\n\u25AA
        \u043A\u0430\u043B\u0456 \u0456\u043D\u0448\u044B \u0433\u0443\u043B\u0435\u0446
        \u0440\u043E\u0431\u0456\u0446\u044C \u041A\u0456\u0434\u043E\u043A-\u0425\u043E\u0434\n\u25AA
        \u0430\u043F\u0456\u0448\u044B\u0446\u0435, \u044F\u043A \u0412\u044B \u0434\u0430\u043F\u0430\u043C\u0430\u0433\u0430\u0435\u0446\u0435
        \u0442\u0430\u043C\u0443 \u0433\u0443\u043B\u044C\u0446\u0443\n\u25AA \u043A\u0456\u043D\u044C\u0446\u0435
        d6, \u044F\u043A  <i>\u041F\u0435\u0440\u0430\u0432\u0430\u0433\u0443</i>
        \u0434\u043B\u044F \u0433\u044D\u0442\u0430\u0433\u0430 \u041A\u0456\u0434\u043A\u0430\n\u25AA
        \u043D\u0435\u043A\u0430\u043B\u044C\u043A\u0456 \u0433\u0443\u043B\u044C\u0446\u043E\u045E
        <u>\u043C\u043E\u0433\u0443\u0446\u044C</u> \u0434\u0430\u043F\u0430\u043C\u0430\u0433\u0447\u044B
        \u0430\u0434\u043D\u0430\u043C\u0443 \u0433\u0443\u043B\u044C\u0446\u0443,
        \u0430\u043B\u0435 \u0431\u043E\u043D\u0443\u0441 \u0431\u0443\u0434\u0437\u0435
        <u>\u0442\u043E\u043B\u044C\u043A\u0456 \u0430\u0434 \u043D\u0430\u0439\u0431\u043E\u043B\u044C\u0448\u0430\u0433\u0430</u>"
