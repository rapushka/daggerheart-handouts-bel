--- !u!1001 &990400643
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 727832745}
    m_Modifications:
    - target: {fileID: 623750329352844552, guid: 938971bbe6071e6dd8a5138f53d4fbba, type: 3}
      propertyPath: m_text
      value: "<b>\u041F\u0430\u0437\u0431\u0435\u0433\u043D\u0443\u0446\u044C \u0421\u043C\u0435\u0440\u0446\u0456</b>
        \u2014 PC \u043F\u0430\u0437\u0431\u044F\u0433\u0430\u0435 \u0441\u043C\u0435\u0440\u0446\u044C,
        \u0430\u043B\u0435 \u0441\u0443\u0442\u044B\u043A\u0430\u0435\u0446\u0446\u0430
        \u0437 \u043D\u0430\u0441\u0442\u0443\u043F\u0441\u0442\u0432\u0430\u043C\u0456
        \n\u25AA PC \u041D\u0435\u043F\u0440\u044B\u0442\u043E\u043C\u043D\u0435\u044E\u0446\u044C
        \u0456 \u0441\u0456\u0442\u0443\u0430\u0446\u044B\u044F \u045E \u0441\u0446\u044D\u043D\u0435
        \u043F\u0430\u0433\u043E\u0440\u0448\u0432\u0430\u0435\u0446\u0446\u0430\n\u25AA
        \u043A\u0456\u043D\u044C\u0446\u0435 \u0414\u0430\u0439\u0441 \u041D\u0430\u0434\u0437\u0435\u0456.
        \u041A\u0430\u043B\u0456 \u0440\u044D\u0437\u0443\u043B\u044C\u0442\u0430\u0442
        \u2264 \u0443\u0437\u0440\u043E\u045E\u043D\u044E \u2014 PC \u0430\u0442\u0440\u044B\u043C\u043E\u045E\u0432\u0430\u0435
        <i>\u0428\u043D\u0430\u0440</i>\n\u25AA PC \u043D\u044F \u043C\u043E\u0436\u0430
        \u0440\u0443\u0445\u0430\u0446\u0446\u0430, \u0434\u0437\u0435\u0439\u043D\u0456\u0447\u0430\u0446\u044C,
        \u0456 \u0456\u0445 \u043D\u0435\u043B\u044C\u0433\u0430 \u0430\u0442\u0430\u043A\u0430\u0432\u0430\u0446\u044C\n\u25AA
        PC \u0430\u043F\u0440\u044B\u0442\u043E\u043C\u043D\u0435\u044E\u0446\u044C,
        \u043A\u0430\u043B\u0456 \u0439\u0456\u043C \u0430\u0447\u044B\u0441\u0446\u044F\u0446\u044C
        \u043F\u0440\u044B\u043D\u0430\u043C\u0441\u0456 1 HP, \u0430\u043B\u044C\u0431\u043E
        \u043F\u0430\u0441\u043B\u044F  <i>\u0414\u043E\u045E\u0433\u0430\u0433\u0430
        \u0410\u0434\u043F\u0430\u0447\u044B\u043D\u043A\u0443</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 623750329352844552, guid: 938971bbe6071e6dd8a5138f53d4fbba, type: 3}
      propertyPath: m_fontSize
